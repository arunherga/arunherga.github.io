{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arun-private-intelligence",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ALLOWED_EMAILS": "arun.b.bhat@gmail.com",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": false }
}
